<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Minimalist HUD -->
    <LinearLayout
        android:id="@+id/hudTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back to Menu Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHudMenu"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_hud"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_menu"
            android:textColor="@color/btn_hud_text"
            android:textSize="12sp" />

        <!-- Level and Timer Display -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="FASE 1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHudTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="00:00.0"
                android:textColor="@color/ball_color"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Calibrate Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHudCalibrate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_hud"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/btn_calibrate"
            android:textColor="@color/btn_hud_text"
            android:textSize="11sp" />

        <!-- Axes Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHudAxes"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_hud"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/btn_axes"
            android:textColor="@color/btn_hud_text"
            android:textSize="11sp" />

        <!-- Restart Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHudRestart"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_hud"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/btn_restart"
            android:textColor="@color/btn_hud_text"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Game View (SurfaceView) -->
    <com.labirinto.tiltmaze.view.VisaoJogo
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/hudTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Victory Overlay (Dark Card with Smooth Actions) -->
    <FrameLayout
        android:id="@+id/overlayVictory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30A0B0E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/tvWinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="@string/dialog_win_title"
                android:textColor="@color/target_color"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvWinTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNextLevel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_start_bg"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="@string/btn_next_level"
                android:textColor="@color/btn_start_text"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOverlayMenu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_exit_bg"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="@string/btn_menu"
                android:textColor="@color/btn_exit_text"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
